// Copy this file to secrets.h (same folder) and fill in your real WiFi
// credentials. secrets.h is gitignored so your password never gets committed.
//
//   cp include/secrets.h.example include/secrets.h

#pragma once

#define WIFI_SSID     "YourWiFiName"
#define WIFI_PASSWORD "YourWiFiPassword"

// Optional: give the board a fixed hostname so it's easy to find on the
// network, e.g. http://accuvis-rail.local (needs mDNS, set up separately).
#define DEVICE_HOSTNAME "accuvis-rail"
