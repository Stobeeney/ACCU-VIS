// Copy this file to secrets.h (same folder) and set your own AP password.
// secrets.h is gitignored so it never gets committed.
//
//   cp include/secrets.h.example include/secrets.h

#pragma once

// The ESP8266 broadcasts its OWN WiFi network (Access Point mode) -- your
// phone/tablet/laptop connects directly to this, no clinic/home router
// needed. Change AP_PASSWORD to whatever you like, just keep it 8+
// characters (WPA2 minimum length).
#define AP_SSID     "AccuVis-Rail"
#define AP_PASSWORD "railcontrol123"
