// Copy this file to secrets.h (same folder) and fill it in.
// secrets.h is gitignored so it never gets committed.
//
//   cp include/secrets.h.example include/secrets.h

#pragma once

// ---------------------------------------------------------------------------
// Cloud relay mode (RAIL_MODE_CLOUD 1 in rail_config.h): the hosted website
// controls the rail through the server.
// ---------------------------------------------------------------------------

// The router WiFi the rail joins (2.4 GHz only -- the ESP8266 cannot use 5 GHz).
#define STA_SSID     "YourRouterName"
#define STA_PASSWORD "YourRouterPassword"

// This rail's identity on the server. Create it with:
//   python ui/database/provision_rail.py rail-1 "Clinic rail"
// which prints the RAIL_SECRET once. The secret is not shown again.
#define RAIL_ID     "rail-1"
#define RAIL_SECRET "paste-the-secret-here"

// OPTIONAL bench override: talk plain HTTP to the python server on your laptop
// (python server.py, port 8080) instead of the hosted site. No encryption: use
// only on a trusted network, never with a real RAIL_SECRET.
//#define CLOUD_HOST "192.168.1.50"
//#define CLOUD_PORT 8080
//#define CLOUD_TLS  0

// ---------------------------------------------------------------------------
// Legacy local mode (RAIL_MODE_CLOUD 0): the rail broadcasts its own WiFi.
// ---------------------------------------------------------------------------
// Change AP_PASSWORD; keep it 8+ characters (WPA2 minimum length).
#define AP_SSID     "AccuVis-Rail"
#define AP_PASSWORD "railcontrol123"
